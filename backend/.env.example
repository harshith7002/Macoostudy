# Copy to backend/.env and fill in real values. Never commit the real file.

# ── Model providers (Career Agent picks the first one configured) ──
# Meta Model API (https://dev.meta.ai/docs) - OpenAI-compatible chat completions at https://api.meta.ai/v1
MODEL_API_KEY=
# Optional: documented IDs include muse-spark-1.3 (default), muse-spark-1.2, muse-spark-1.1, muse-wonder-1.0
META_MODEL=muse-spark-1.3
# Optional: none | minimal | low | medium | high | xhigh | max
META_REASONING_EFFORT=low

# Groq - used by the roast/ATS features, and by Career Agent when no Meta key is set
GROQ_API_KEY=
# Optional: pin a Groq model; otherwise get_best_model() picks one that works for the key
GROQ_MODEL=

# Optional: force a Career Agent provider: meta | groq | offline (deterministic heuristics, no LLM)
CAREER_AGENT_PROVIDER=
# Optional tuning
CAREER_AGENT_TIMEOUT=40
CAREER_AGENT_INTERVIEW_CLAIMS=4
CAREER_AGENT_MAX_PER_CLAIM=3

# ── Database ──
# Supabase Postgres connection string in production; omit locally to use SQLite (DB_PATH)
DATABASE_URL=
DB_PATH=macoostudy.db

# ── Payments ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Comma-separated list of allowed CORS origins (default *)
ALLOWED_ORIGINS=
